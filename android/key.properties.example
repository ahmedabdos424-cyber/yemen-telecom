# Android Release Signing Configuration
# Copy this file to key.properties and fill in your actual values.
# DO NOT commit key.properties to version control.
#
# Generate a keystore:
#   keytool -genkey -v -keystore release.keystore -alias your-alias-name -keyalg RSA -keysize 2048 -validity 10000
#
# storeFile path is relative to android/app/

storeFile=release.keystore
storePassword=your-keystore-password
keyAlias=your-key-alias
keyPassword=your-key-password
