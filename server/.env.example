# Server Configuration
NODE_ENV=development
API_PORT=4000

# CORS — comma-separated origins
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# PostgreSQL / Supabase
DB_HOST=your-supabase-host.pooler.supabase.com
DB_PORT=5432
DB_USER=postgres.your-project-ref
DB_PASSWORD="your-supabase-password"
DB_NAME=postgres
DB_SSL_REJECT_UNAUTHORIZED=true
DB_SSL_CA_CERT=
DB_FAMILY=4
DB_MAX_CONNECTIONS=20
DB_MIN_CONNECTIONS=3
DB_SLOW_QUERY_MS=500

# Sentry (error tracking) — optional
SENTRY_DSN=

# JWT Secrets — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-me-to-a-random-64-char-hex-string
REFRESH_SECRET=change-me-to-another-random-64-char-hex-string
CSRF_SECRET=change-me-to-a-third-random-64-char-hex-string
# REQUIRED — HMAC key protecting the token blacklist. The server refuses to
# start without it. Also 64 hex chars (same generator as above).
BLACKLIST_HMAC_SECRET=change-me-to-a-fourth-random-64-char-hex-string

# Reset inventory confirmation token — REQUIRED in production
RESET_CONFIRM_TOKEN=

# Image uploads — Supabase Storage (public bucket)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key
UPLOAD_BUCKET=uploads

# Seed passwords — optional, per-user unique credentials for seed accounts
# If not set, each account gets a cryptographically random password
# SEED_PASSWORD_MANAGER=MyManagerPass1
# SEED_PASSWORD_AGENT=MyAgentPass1
# SEED_PASSWORD_SELLER=MySellerPass1

# Android self-updater — public /api/app-version response
# APP_VERSION must match android/app/build.gradle versionName
APP_VERSION=1.1.0
# APP_VERSION_CODE must match android/app/build.gradle versionCode (e.g. 100,101,102).
# Used to prevent downgrades even if versionName is spoofed.
APP_VERSION_CODE=24
# Preferred: a Supabase Storage object path (versioned filename, e.g. releases/app-1.2.0.apk).
# A short-lived (1h) signed URL is generated per request — never a permanent public link.
APP_APK_BUCKET=uploads
APP_APK_OBJECT=
# Fallback static URL (must be https). Ignored if APP_APK_OBJECT is set.
APP_APK_URL=
# SHA-256 (hex, uppercase) of the APK — the client verifies this after download
# and deletes the file + shows "ملف التحديث تالف" if it does not match.
APP_APK_SHA256=D5C8A8E3966CD3B8B8F1E20875DD1DE8B583C00C0533DB86E6F5147C7A3E5002
# Exact APK byte size — quick integrity / partial-download guard.
APP_APK_SIZE=30054537
# Optional: pipe-separated release notes shown in the update dialog
APP_UPDATE_NOTES=فحص أمني شامل — 22 إصلاح|تحسينات RBAC وصلاحيات الأدوار|إصلاحات أداء Race Conditions وTOCTOU|تحسينات Schema وتنقيح قاعدة البيانات
# Force the update (blocks app entry until updated): true/false
APP_UPDATE_REQUIRED=false
# Rollback: set APP_VERSION to the previous good version (e.g. 1.3.9) with
# APP_UPDATE_REQUIRED=false so users can return to it if a newer build is bad.

# External backup storage (S3-compatible: Backblaze B2, Cloudflare R2, AWS S3)
# Required for durable online backups. Without these, /api/admin/system/backup will fail.
# BACKUP_S3_ENDPOINT=s3.us-west-004.backblazeb2.com
# BACKUP_S3_REGION=us-east-1
# BACKUP_S3_ACCESS_KEY_ID=your-access-key
# BACKUP_S3_SECRET_ACCESS_KEY=your-secret-key
# BACKUP_S3_BUCKET=your-bucket-name


# Firebase Cloud Messaging (push notifications) -- optional. Without these,
# /api/notifications works but sends are no-ops and push stays disabled.
# Create a service account in Firebase Console > Project settings > Service accounts
# and paste its fields below (the full service-account JSON keys).
# FIREBASE_PROJECT_ID=your-firebase-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxx@your-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
# FIREBASE_PRIVATE_KEY_ID=your-private-key-id
# FIREBASE_CLIENT_ID=your-client-id
# FIREBASE_CLIENT_CERT_URL=https://www.googleapis.com/robot/v1/metadata/x509/firebase-adminsdk-xxxx%40your-project.iam.gserviceaccount.com
# FIREBASE_STORAGE_BUCKET=your-project.appspot.com
