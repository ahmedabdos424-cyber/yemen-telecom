{
  "name": "yemen-telecom",
  "private": true,
  "version": "1.0.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "type": "module",
  "scripts": {
    "start": "node server/dist/index.js",
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "build:android": "vite build && npx cap copy",
    "cap:sync": "npx cap sync",
    "preview": "vite preview",
    "clean": "node -e \"const fs=require('fs');['dist','server.js'].forEach(p=>fs.rmSync(p,{recursive:true,force:true}));\"",
    "lint": "tsc --noEmit",
    "server": "tsx watch server/src/index.ts",
    "db:seed": "tsx server/src/seed.ts",
    "tunnel": "node tunnel.js",
    "tunnel:ps": "powershell -File start-tunnel.ps1",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@capacitor-firebase/authentication": "8.3.0",
    "@capacitor-firebase/storage": "8.3.0",
    "@capacitor/android": "8.4.1",
    "@capacitor/cli": "8.4.1",
    "@capacitor/core": "8.4.1",
    "@capacitor/keyboard": "8.0.5",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/status-bar": "^8.0.1",
    "@google/genai": "^2.4.0",
    "@sentry/react": "^10.62.0",
    "@sentry/vite-plugin": "^5.3.0",
    "d3": "^7.9.0",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^0.546.0",
    "motion": "12.42.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router-dom": "^7.18.0",
    "sharp": "^0.35.3",
    "tesseract.js": "^7.0.0",
    "uuid": "14.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/d3": "^7.4.3",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@vitest/coverage-v8": "4.1.9",
    "esbuild": "^0.25.0",
    "jsdom": "^29.1.1",
    "ngrok": "^5.0.0-beta.2",
    "tailwindcss": "4.3.1",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "@tailwindcss/vite": "4.3.1",
    "@vitejs/plugin-react": "^5.0.4",
    "vite": "6.4.3",
    "vitest": "4.1.9"
  },
  "optionalDependencies": {
    "@rollup/rollup-win32-x64-msvc": "^4.34.9"
  },
  "allowScripts": {
    "@firebase/util@1.15.1": true,
    "@google/genai@2.7.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "ngrok@5.0.0-beta.2": true,
    "protobufjs@7.6.4": true,
    "sharp@0.34.5": true,
    "tesseract.js@7.0.0": true
  }
}
