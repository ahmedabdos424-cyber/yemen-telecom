# ============================================
# Yemen Telecom - Development Environment (reference only)
# ============================================
# The canonical env reference is server/.env.example — the server loads
# server/.env (dotenv resolves ../.env from server/src). This root file is
# kept only as a quick-start mirror so editors see the full key set; keep its
# keys in sync with server/.env.example. Never commit real secret values.
# ============================================

# Server
NODE_ENV=development
API_PORT=4000
# CORS — comma-separated origins (dev mode allows all origins)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# PostgreSQL / Supabase
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=yemen_telecom
DB_SSL_REJECT_UNAUTHORIZED=false
DB_SSL_CA_CERT=
DB_FAMILY=4
DB_MAX_CONNECTIONS=20
DB_MIN_CONNECTIONS=3
DB_SLOW_QUERY_MS=500

# Sentry (error tracking — optional in dev; DSN is public, but use your own key)
SENTRY_DSN=https://YOUR_SENTRY_PUBLIC_KEY@o4511821570310144.ingest.de.sentry.io/4511821594034256
# Frontend Sentry (VITE_ prefix for Vite build-time injection)
VITE_SENTRY_DSN=https://YOUR_SENTRY_PUBLIC_KEY@o4511821570310144.ingest.de.sentry.io/4511821594034256

# JWT Secrets — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-64-char-hex
REFRESH_SECRET=your-64-char-hex
CSRF_SECRET=your-64-char-hex
# REQUIRED — the server refuses to start without it
BLACKLIST_HMAC_SECRET=your-64-char-hex

# Reset inventory confirmation token (optional; defaults to RESET_INVENTORY)
RESET_CONFIRM_TOKEN=RESET_INVENTORY

# Image uploads — Supabase Storage (public bucket)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key
UPLOAD_BUCKET=uploads
# Documented for compatibility; the server stores uploads in Supabase Storage
UPLOAD_DIR=uploads

# Seed passwords — optional, per-user unique credentials for seed accounts
# If not set, each account gets a cryptographically random password
# SEED_PASSWORD_MANAGER=MyManagerPass1
# SEED_PASSWORD_AGENT=MyAgentPass1
# SEED_PASSWORD_SELLER=MySellerPass1

# Android self-updater — public /api/app-version response
# APP_VERSION / APP_VERSION_CODE must match android/app/build.gradle
# and server/.env.example (canonical reference). Kept in sync: 1.1.0 / 24.
APP_VERSION=1.1.0
APP_VERSION_CODE=24
APP_APK_BUCKET=apk-releases
APP_APK_OBJECT=
APP_APK_URL=
APP_APK_SHA256=D5C8A8E3966CD3B8B8F1E20875DD1DE8B583C00C0533DB86E6F5147C7A3E5002
APP_APK_SIZE=30054537
APP_UPDATE_NOTES=فحص أمني شامل — 22 إصلاح|تحسينات RBAC وصلاحيات الأدوار|إصلاحات أداء Race Conditions وTOCTOU|تحسينات Schema وتنقيح قاعدة البيانات
APP_UPDATE_REQUIRED=false

# External backup storage (S3-compatible: Backblaze B2, Cloudflare R2, AWS S3)
# Optional in dev; required for durable online backups in production.
# BACKUP_S3_ENDPOINT=s3.us-west-004.backblazeb2.com
# BACKUP_S3_REGION=us-east-1
# BACKUP_S3_ACCESS_KEY_ID=your-access-key
# BACKUP_S3_SECRET_ACCESS_KEY=your-secret-key
# BACKUP_S3_BUCKET=your-bucket-name

# Firebase Cloud Messaging (push notifications) — optional.
# See server/.env.example for the full service-account key list.
# FIREBASE_PROJECT_ID=your-firebase-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxx@your-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----