# Server Configuration
NODE_ENV=development
API_PORT=4000

# CORS — comma-separated origins
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# PostgreSQL / Supabase
DB_HOST=your-supabase-host.pooler.supabase.com
DB_PORT=5432
DB_USER=postgres.your-project-ref
DB_PASSWORD="your-supabase-password"
DB_NAME=postgres
DB_SSL_REJECT_UNAUTHORIZED=true
DB_SSL_CA_CERT=
DB_FAMILY=4
DB_MAX_CONNECTIONS=10
DB_SLOW_QUERY_MS=500

# JWT Secrets — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-me-to-a-random-64-char-hex-string
REFRESH_SECRET=change-me-to-another-random-64-char-hex-string
CSRF_SECRET=change-me-to-a-third-random-64-char-hex-string

# Firebase Admin (required for image uploads; populate from Firebase service-account JSON)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY_ID= (optional — from service-account JSON)
FIREBASE_CLIENT_ID= (optional — from service-account JSON)
FIREBASE_CLIENT_CERT_URL=https://www.googleapis.com/robot/v1/metadata/x509/firebase-adminsdk-xxxxx%40your-project-id.iam.gserviceaccount.com
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

# Seed passwords — optional, per-user unique credentials for seed accounts
# If not set, each account gets a cryptographically random password
# SEED_PASSWORD_MANAGER=MyManagerPass1
# SEED_PASSWORD_AGENT=MyAgentPass1
# SEED_PASSWORD_SELLER=MySellerPass1

# External backup storage (S3-compatible: Backblaze B2, Cloudflare R2, AWS S3)
# Required for durable online backups. Without these, /api/admin/system/backup will fail.
# BACKUP_S3_ENDPOINT=s3.us-west-004.backblazeb2.com
# BACKUP_S3_REGION=us-east-1
# BACKUP_S3_ACCESS_KEY_ID=your-access-key
# BACKUP_S3_SECRET_ACCESS_KEY=your-secret-key
# BACKUP_S3_BUCKET=your-bucket-name
