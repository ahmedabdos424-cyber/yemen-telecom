# ============================================
# Yemen Telecom - Development Environment
# ============================================
# Copy this file to .env and adjust values.
# For production deployment, see server/.env.example
# for the complete list of required variables.
# ============================================

# Server
NODE_ENV=development
API_PORT=4000
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=yemen_telecom

# Secrets (generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=your-64-char-hex
REFRESH_SECRET=your-64-char-hex
CSRF_SECRET=your-64-char-hex

# Image uploads — local disk directory served at /uploads
UPLOAD_DIR=uploads

# App URL
APP_URL=http://localhost:5173

# Sentry (error tracking - optional in dev)
SENTRY_DSN=https://e26574aa3569ad8263215c8c58a3be4b@o4511821570310144.ingest.de.sentry.io/4511821594034256
# Frontend Sentry (VITE_ prefix for Vite build-time injection)
VITE_SENTRY_DSN=https://e26574aa3569ad8263215c8c58a3be4b@o4511821570310144.ingest.de.sentry.io/4511821594034256
