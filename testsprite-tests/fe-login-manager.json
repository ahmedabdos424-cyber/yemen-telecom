{
  "projectId": "ae188b56-e8c8-47ae-98f0-bb0d01f6b385",
  "type": "frontend",
  "name": "Manager login with valid credentials succeeds",
  "description": "Verify manager can log in and reaches dashboard",
  "planSteps": [
    {
      "type": "action",
      "description": "Navigate to the application at the target URL",
      "action": "navigate",
      "url": "{{TARGET_URL}}"
    },
    {
      "type": "action",
      "description": "Wait for the login screen to load",
      "action": "wait",
      "timeout": 10000
    },
    {
      "type": "action",
      "description": "Select the manager role from the role selector",
      "action": "click",
      "selector": "text=مدير عام"
    },
    {
      "type": "action",
      "description": "Enter the manager username",
      "action": "fill",
      "selector": "input[type='text'], input[name='username']",
      "value": "manager"
    },
    {
      "type": "action",
      "description": "Enter the manager password",
      "action": "fill",
      "selector": "input[type='password']",
      "value": "Admin@123"
    },
    {
      "type": "action",
      "description": "Click the login button",
      "action": "click",
      "selector": "button[type='submit']"
    },
    {
      "type": "assertion",
      "description": "Verify the dashboard loads after login",
      "assertion": "page URL contains /manager/dashboard or dashboard content is visible"
    }
  ]
}
