{
  "name": "yemen-telecom",
  "private": true,
  "version": "1.1.0",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "type": "module",
  "scripts": {
    "start": "node server/dist/index.js",
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "build:android": "vite build && npx cap copy",
    "cap:sync": "npx cap sync",
    "preview": "vite preview",
    "clean": "node -e \"const fs=require('fs');['dist','server.js'].forEach(p=>fs.rmSync(p,{recursive:true,force:true}));\"",
    "lint": "tsc --noEmit",
    "server": "tsx watch server/src/index.ts",
    "db:seed": "tsx server/src/seed.ts",
    "tunnel": "powershell -File start-tunnel.ps1",
    "tunnel:ps": "powershell -File start-tunnel.ps1",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@capacitor-firebase/messaging": "^8.5.1",
    "@capacitor/android": "^8.5.1",
    "@capacitor/camera": "^8.2.4",
    "@capacitor/cli": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/keyboard": "8.0.5",
    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/status-bar": "^8.0.3",
    "@sentry/react": "^10.73.0",
    "d3": "^7.9.0",
    "firebase": "^12.18.0",
    "idb": "^8.0.3",
    "lucide-react": "^1.43.0",
    "motion": "12.42.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@supabase/supabase-js": "^2.115.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/cors": "^2.8.19",
    "@types/d3": "^7.4.3",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "^4.1.11",
    "esbuild": "^0.25.0",
    "jsdom": "^29.1.1",
    "sharp": "0.35.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "~5.8.2",
    "vite": "6.4.3",
    "vitest": "^4.1.11"
  },
  "optionalDependencies": {
    "@rollup/rollup-win32-x64-msvc": "^4.34.9"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "protobufjs@7.6.4": true,
    "sharp@0.35.3": true,
    "tesseract.js@7.0.0": true
  },
  "overrides": {
    "semver": "^7.6.2",
    "body-parser": "^1.20.3",
    "uuid": "^11.1.1",
    "extract-zip": "^2.0.1",
    "sharp": "0.35.4"
  }
}
